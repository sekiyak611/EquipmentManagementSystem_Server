# Docker の MySQL のパスワードの見本（compose.yaml。環境構築手順書 手順5）。
# このファイルをコピーして、同じフォルダに .env という名前で置き、値を書く。
# .env は Git で管理しない（.gitignore に入れてある）。このファイル（.env.example）には値を書かない。

# root（管理者）のパスワード。自分で決める
MYSQL_ROOT_PASSWORD=

# アプリ用のユーザ（equipment）のパスワード。secret.yml の spring.datasource.password と同じ値にする
MYSQL_PASSWORD=

# PC 側の番号。ほかの MySQL が 3306 を使っていてぶつかるときだけ変える（そのときは application-*.yml の番号も合わせる必要がある）
MYSQL_PORT=3306
