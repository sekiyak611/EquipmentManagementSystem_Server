<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- users の、手で書く SQL（読むだけ。CLAUDE.md 4.1・5章）。JOIN とサブクエリは使わない。値は #{} で渡す。
     大文字・小文字を区別せずに探すため、氏名を小文字にそろえて比べる（データ設計 2章）。 -->
<mapper namespace="jp.co.highjunk.equipment.dao.mapper.custom.UserCustomMapper">

	<select id="selectIdsByNameContaining" resultType="long">
		SELECT id
		FROM users
		WHERE LOWER(name) LIKE #{keywordPattern} ESCAPE '!'
	</select>
</mapper>
