<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- auth 機能の role_permissions の SQL（詳細設計 auth/A-01_ログイン.md・A-03_ログイン中の人の情報.md の7章）。
     JOIN とサブクエリは使わない。値は #{} で渡す（CLAUDE.md 5章）。 -->
<mapper namespace="jp.co.highjunk.equipment.mapper.auth.RolePermissionMapper">

	<select id="selectPermissionCodesByRoleId" resultType="string">
		SELECT permission_code
		FROM role_permissions
		WHERE role_id = #{roleId}
	</select>
</mapper>
