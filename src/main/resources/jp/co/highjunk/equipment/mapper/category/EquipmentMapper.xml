<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- category 機能の equipment の SQL（詳細設計 category/K-01_種別一覧.md・K-03_種別を変える.md・K-04_種別を消す.md の7章）。読むだけ。
     JOIN とサブクエリは使わない。値は #{} で渡す（CLAUDE.md 5章）。 -->
<mapper namespace="jp.co.highjunk.equipment.mapper.category.EquipmentMapper">

	<!-- 管理状態（status）は問わない。廃棄・不明の備品も数える（画面設計 16章「削除されていない備品」） -->
	<select id="countGroupByCategoryId" resultType="jp.co.highjunk.equipment.category.model.CategoryEquipmentCount">
		SELECT category_id, COUNT(*) AS equipment_count
		FROM equipment
		WHERE deleted_at IS NULL
		GROUP BY category_id
	</select>

	<select id="countByCategoryId" resultType="long">
		SELECT COUNT(*)
		FROM equipment
		WHERE category_id = #{categoryId}
		  AND deleted_at IS NULL
	</select>

	<!-- K-04：確定したばかりの行も数える読み方（FOR SHARE）。K-04 の8章 -->
	<select id="countByCategoryIdForShare" resultType="long">
		SELECT COUNT(*)
		FROM equipment
		WHERE category_id = #{categoryId}
		  AND deleted_at IS NULL
		FOR SHARE
	</select>
</mapper>
