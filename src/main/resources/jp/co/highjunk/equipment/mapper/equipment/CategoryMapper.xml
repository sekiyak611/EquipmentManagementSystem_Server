<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- equipment 機能の categories の SQL（詳細設計 equipment/C-01_備品を探す.md の7章）。読むだけ。 -->
<mapper namespace="jp.co.highjunk.equipment.mapper.equipment.CategoryMapper">

	<!-- 備品が指していれば名前を出すため、削除済みの種別も読む -->
	<select id="selectByIds" resultType="jp.co.highjunk.equipment.equipment.model.Category">
		SELECT id, name
		FROM categories
		WHERE id IN
		<foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
	</select>
	<!-- C-03：K-04 の FOR UPDATE と押さえ合うので、確かめてから足すまでの間に種別を消されない（category.md 3章の No.2） -->
	<select id="selectByIdForShare" resultType="jp.co.highjunk.equipment.equipment.model.Category">
		SELECT id, name
		FROM categories
		WHERE id = #{id}
		  AND deleted_at IS NULL
		FOR SHARE
	</select>
</mapper>
