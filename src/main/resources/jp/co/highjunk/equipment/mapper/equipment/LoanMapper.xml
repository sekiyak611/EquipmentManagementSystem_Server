<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- equipment 機能の loans の SQL（詳細設計 equipment/C-01_備品を探す.md の7章）。JOIN とサブクエリは使わない（CLAUDE.md 5章）。 -->
<mapper namespace="jp.co.highjunk.equipment.mapper.equipment.LoanMapper">

	<!-- 貸出中＝返却日が空で、取り消されていない（deleted_at が空）行。データ設計 5.7 -->
	<select id="selectActive" resultType="jp.co.highjunk.equipment.equipment.model.Loan">
		SELECT equipment_id, user_id
		FROM loans
		WHERE returned_on IS NULL
		  AND deleted_at IS NULL
	</select>
	<!-- C-06：二重貸出は重複禁止（active_equipment_id）で防いでいるので、0〜1件 -->
	<select id="selectActiveByEquipmentId" resultType="jp.co.highjunk.equipment.equipment.model.Loan">
		SELECT equipment_id, user_id
		FROM loans
		WHERE equipment_id = #{equipmentId}
		  AND returned_on IS NULL
		  AND deleted_at IS NULL
	</select>
</mapper>
